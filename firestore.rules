
/**
 * @file Firestore Security Rules
 * @description This ruleset enforces that users can only access their own data.
 *
 * Core Philosophy:
 *  - Data is owned by the user who created it, identified by a 'userId' field in each document.
 *  - Users can only read, write, update, or delete documents that contain their own UID in the 'userId' field.
 *  - The 'professor_profile' collection is a special case where the document ID is the user's UID.
 *
 * Key Security Decisions:
 *  - All collections are protected by ownership rules. There is no public data.
 *  - Schema validation is enforced on write operations to ensure data integrity.
 *
 * Helper Functions:
 *  - isSignedIn(): Checks if the user is authenticated.
 *  - isOwner(userId): Checks if the authenticated user's UID matches the document's 'userId' field.
 *  - isCreatingOwner(): Checks if the user is creating a document and setting themselves as the owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isCreatingOwner() {
      return request.auth.uid == request.resource.data.userId;
    }

    /**
     * @description Enforces ownership for Institution documents.
     * @path /institutions/{institutionId}
     */
    match /institutions/{institutionId} {
      allow create: if isSignedIn() && isCreatingOwner();
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    /**
     * @description Enforces ownership for Department documents.
     * @path /departments/{departmentId}
     */
    match /departments/{departmentId} {
      allow create: if isSignedIn() && isCreatingOwner();
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    /**
     * @description Enforces ownership for Student documents.
     * @path /students/{studentId}
     */
    match /students/{studentId} {
      allow create: if isSignedIn() && isCreatingOwner();
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    /**
     * @description Enforces ownership for Attendance documents.
     * @path /attendances/{attendanceId}
     */
    match /attendances/{attendanceId} {
      allow create: if isSignedIn() && isCreatingOwner();
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    /**
     * @description Enforces ownership for EvaluationCriteria documents.
     * @path /evaluation_criteria/{evaluationCriteriaId}
     */
    match /evaluation_criteria/{evaluationCriteriaId} {
      allow create: if isSignedIn() && isCreatingOwner();
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    /**
     * @description Enforces ownership for Evaluation documents.
     * @path /evaluations/{evaluationId}
     */
    match /evaluations/{evaluationId} {
       allow create: if isSignedIn() && isCreatingOwner();
       allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    /**
     * @description Enforces ownership for SessionEvaluation documents.
     * @path /session_evaluations/{evaluationId}
     */
    match /session_evaluations/{evaluationId} {
      allow create: if isSignedIn() && isCreatingOwner();
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    /**
     * @description Enforces ownership for Grade documents.
     * @path /grades/{gradeId}
     */
    match /grades/{gradeId} {
      allow create: if isSignedIn() && isCreatingOwner();
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    /**
     * @description Allows users to read and write ONLY their own professor profile.
     * @path /professor_profile/{userId}
     */
    match /professor_profile/{userId} {
       allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Allows authenticated users to manage their own daily logs.
     * @path /daily_logs/{logId}
     */
    match /daily_logs/{logId} {
        allow create: if isSignedIn() && isCreatingOwner();
        allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    /**
     * @description Allows authenticated users to manage their own sports equipment inventory.
     * @path /sports_equipment/{equipmentId}
     */
    match /sports_equipment/{equipmentId} {
      allow create: if isSignedIn() && isCreatingOwner();
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    /**
     * @description Allows authenticated users to manage their own timetable entries.
     * @path /timetable_entries/{entryId}
     */
    match /timetable_entries/{entryId} {
      allow create: if isSignedIn() && isCreatingOwner();
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }
  }
}

    