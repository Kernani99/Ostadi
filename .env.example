# انسخ هذا الملف إلى ‎.env.local‎ (لا يُرفع إلى المستودع) واملأ القيم.

# الكابتشا: مفتاح الموقع (site key) لـ reCAPTCHA v3 المسجَّل في Firebase App Check.
# بدون هذه القيمة تبقى الكابتشا معطّلة. المفتاح السري (secret key) يوضع في لوحة Firebase فقط، لا هنا.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# للتطوير المحلي فقط (localhost): يطبع رمز تصحيح يُسجَّل في لوحة App Check.
# NEXT_PUBLIC_APPCHECK_DEBUG=true

# المساعد الذكي موقوف افتراضياً (قيد التطوير). لتفعيله لاحقاً: AI_ASSISTANT_ENABLED=true مع المفتاح أدناه،
# ثم أعد استعمال <AssistantChat /> في src/app/(main)/ai-assistant/page.tsx.
# AI_ASSISTANT_ENABLED=false

# مفتاح Anthropic للمساعد الذكي — يُقرأ في الخادم فقط.
# لا تضع أبداً مفتاحاً سرياً في متغير يبدأ بـ NEXT_PUBLIC_ : كل ما يبدأ بها يُضمَّن في جافاسكربت المتصفح.
ANTHROPIC_API_KEY=

# اختياري: معرّف مشروع Firebase للتحقق من رموز الهوية في الخادم (الافتراضي من src/firebase/config.ts).
# FIREBASE_PROJECT_ID=
